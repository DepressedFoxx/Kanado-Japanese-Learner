# Kết nối Postgres.
# Neon: lấy cả hai chuỗi trong Neon Console → Connection Details.
#   DATABASE_URL = "Pooled connection" (hostname có -pooler) khi chạy serverless,
#                  hoặc chuỗi direct nếu chạy server thường (Render, VM).
#   DIRECT_URL   = chuỗi direct, luôn dùng cho migration.
# Cả hai chuỗi dán được thẳng vào DBeaver.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Postgres local trong Docker:
# DATABASE_URL="postgresql://kanado:kanado@localhost:5432/kanado?schema=public"
# DIRECT_URL="postgresql://kanado:kanado@localhost:5432/kanado?schema=public"

# Đổi thành chuỗi ngẫu nhiên dài trước khi deploy: openssl rand -base64 48
JWT_ACCESS_SECRET="doi-chuoi-nay-truoc-khi-deploy"
JWT_REFRESH_SECRET="doi-chuoi-nay-nua-va-khac-cai-tren"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=4000
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy
CORS_ORIGINS="http://localhost:3000"
